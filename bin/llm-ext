// ── Help output ──────────────────────────────────────────────────────

function showHelp(toolName) {
  if (toolName && TOOL_CATALOG[toolName]) {
    const t = TOOL_CATALOG[toolName];
    console.log(`\n${toolName}: ${t.desc}\n`);
    const params = Object.entries(t.params);
    if (params.length === 0) {
      console.log("  No parameters.\n");
    } else {
      console.log("Parameters:");
      for (const [k, v] of params) {
        console.log(`  --${k.padEnd(22)} ${v}`);
      }
      console.log();
    }
    console.log("Example:");
    if (toolName === "discover") {
      console.log("  llm-ext discover");
    } else if (toolName === "code_task") {
      console.log('  llm-ext code_task --instructions "Find bugs" --input_files_paths /path/to/file.ts');
    } else {
      console.log(`  llm-ext ${toolName} --instructions "..." --input_files_paths /path/to/file`);
    }
    return;
  }

  console.log(`
LLM Externalizer CLI — call tools from any agent via Bash.

Usage:
  llm-ext <tool> [--param value ...]
  llm-ext --help              Show this help
  llm-ext --help <tool>       Show tool parameters

Tools:`);
  for (const [name, t] of Object.entries(TOOL_CATALOG)) {
    const deprecated = name === "batch_check" ? " (DEPRECATED)" : "";
    console.log(`  ${name.padEnd(22)} ${t.desc}${deprecated}`);
  }
  console.log(`
Output: file path to the saved report (printed to stdout).
Reports saved to: reports_dev/llm_externalizer/ in the current working directory.
Paths: absolute paths recommended. Relative paths resolve from cwd.
Timeout: 10 minutes. Temperature: 0.1 (fixed, not configurable).
`);
}

// ── Argument parsing ─────────────────────────────────────────────────

function parseArgs(argv) {
  const args = argv.slice(2);

  if (args.length === 0 || args[0] === "--help" || args[0] === "-h") {
    showHelp(args[1]);
    process.exit(0);
  }

  const tool = args[0];
  if (!TOOL_CATALOG[tool]) {
    console.error(`Unknown tool: ${tool}`);
    console.error("Run 'llm-ext --help' for available tools.");
    process.exit(1);
  }

  const params = {};
  for (let i = 1; i < args.length; i++) {
    const arg = args[i];
    if (arg === "--help" || arg === "-h") {
      showHelp(tool);
      process.exit(0);
    }
    if (arg.startsWith("--")) {
      const eqIdx = arg.indexOf("=");
      let key, value;
      if (eqIdx !== -1) {
        key = arg.slice(2, eqIdx);
        value = arg.slice(eqIdx + 1);
      } else {
        key = arg.slice(2);
        const next = args[i + 1];
        if (next !== undefined && !next.startsWith("--")) {
          value = next;
          i++;
        } else {
          value = "true";
        }
      }
      try { params[key] = JSON.parse(value); } catch { params[key] = value; }
    } else {
      console.error(`ERROR: Unexpected positional argument: '${arg}'. Use --flag value syntax.`);
      console.error("Run 'llm-ext --help' for usage.");
      process.exit(1);
    }
  }

  return { tool, params };
}

// ── MCP server communication ─────────────────────────────────────────

function sendJson(child, obj) {
  try {
    child.stdin.write(JSON.stringify(obj) + "\n");
  } catch {
    // stdin closed (server crashed) — handled by exit/error handlers
  }
}

// Graceful SIGTERM → SIGKILL escalation before exiting. Replaces the
// race-prone `child.kill(); process.exit(code);` pattern — a bare
// `child.kill()` sends SIGTERM and does NOT wait for the child to
// finish; the immediate `process.exit` then orphans the child, which
// survives as a zombie under init/systemd on POSIX. This helper waits
// up to `timeoutMs` for the child to exit after SIGTERM and only then
// escalates to SIGKILL, guaranteeing the child is reaped before we
// disappear.
function killAndExit(child, code, timeoutMs = 2000) {
  if (child.exitCode !== null) {
    // Child already exited — no kill needed.
    process.exit(code);
    return;
  }
  let done = false;
  const finish = () => {
    if (done) return;
    done = true;
    process.exit(code);
  };
  child.once("exit", finish);
  try {
    child.kill("SIGTERM");
  } catch {
    // Child died between exitCode check and kill — still exit cleanly.
    finish();
    return;
  }
  // Escalate to SIGKILL if the child ignores SIGTERM. unref() so the
  // timer never keeps the event loop alive on its own.
  setTimeout(() => {
    if (done) return;
    try {
      child.kill("SIGKILL");
    } catch {
      // Already gone.
    }
    finish();
  }, timeoutMs).unref();
}

async function main() {
  const { tool, params } = parseArgs(process.argv);

  // Verify server binary exists
  const serverPath = join(__dirname, "..", "mcp-server", "dist", "index.js");
  if (!existsSync(serverPath)) {
    console.error(`ERROR: MCP server not found at ${serverPath}`);
    console.error("Run 'python3 scripts/setup.py' in the plugin directory to build it.");
    process.exit(1);
  }

  const child = spawn("node", [serverPath], {
    stdio: ["pipe", "pipe", "pipe"],
    env: { ...process.env },
  });

  // Handle spawn errors (e.g., node not found)
  child.on("error", (err) => {
    console.error(`ERROR: Failed to start MCP server: ${err.message}`);
    process.exit(1);
  });

  // Handle unexpected server exit before we get a response.
  // NOTE: the exit event can fire before the final stdout data events are
  // processed.  We track the exit code here but defer the crash check to
  // stdout.on("end"), which is guaranteed to fire only after all data has
  // been delivered to our handlers.
  let gotResponse = false;
  let exitCode = null;
  child.on("exit", (code) => {
    exitCode = code;
  });

  // Line-buffered JSON-RPC parsing — handles partial chunks correctly
  let lineBuf = "";

  function onLine(line) {
    if (!line.trim()) return;
    try {
      const msg = JSON.parse(line);
      handleMessage(msg);
    } catch {
      // Not valid JSON — ignore (server log line or partial data)
    }
  }

  let phase = "init"; // init → ready → waiting

  function handleMessage(msg) {
    if (phase === "init" && msg.id === 0) {
      if (msg.error) {
        gotResponse = true;
        clearTimeout(deadline);
        console.error(`ERROR: MCP server rejected initialize: ${JSON.stringify(msg.error)}`);
        killAndExit(child, 1);
        return;
      }
      if (msg.result) {
        // Init response received — send initialized notification + tool call
        phase = "ready";
        sendJson(child, { jsonrpc: "2.0", method: "notifications/initialized" });
        sendJson(child, {
          jsonrpc: "2.0", id: 1, method: "tools/call",
          params: { name: tool, arguments: params },
        });
        phase = "waiting";
      } else {
        gotResponse = true;
        clearTimeout(deadline);
        console.error(`ERROR: MCP server sent malformed initialize response: ${JSON.stringify(msg)}`);
        killAndExit(child, 1);
        return;
      }
      return;
    }

    if (phase === "waiting" && msg.id === 1) {
      if (msg.error) {
        gotResponse = true;
        clearTimeout(deadline);
        console.error(`ERROR: Tool call failed: ${JSON.stringify(msg.error)}`);
        killAndExit(child, 1);
        return;
      }
      if (msg.result) {
        // Tool response received — print result and exit
        gotResponse = true;
        clearTimeout(deadline);
        const content = msg.result.content;
        if (Array.isArray(content)) {
          const text = content
            .filter((c) => c.type === "text")
            .map((c) => c.text)
            .join("\n");
          console.log(text);
          killAndExit(child, msg.result.isError === true ? 1 : 0);
        } else {
          console.error(`ERROR: Tool response missing content array: ${JSON.stringify(msg.result)}`);
          killAndExit(child, 1);
        }
      } else {
        gotResponse = true;
        clearTimeout(deadline);
        console.error(`ERROR: MCP server sent malformed tool response: ${JSON.stringify(msg)}`);
        killAndExit(child, 1);
      }
    }
  }

  child.stdout.on("data", (chunk) => {
    lineBuf += chunk.toString();
    const lines = lineBuf.split("\n");
    // Keep the last (potentially incomplete) line in the buffer
    lineBuf = lines.pop() || "";
    for (const line of lines) {
      onLine(line);
    }
  });

  child.stdout.on("end", () => {
    if (lineBuf) {
      onLine(lineBuf);
      lineBuf = "";
    }
    if (!gotResponse) {
      console.error(`ERROR: MCP server exited unexpectedly (code ${exitCode})`);
      process.exit(1);
    }
  });

  // Send initialize request — response triggers the rest via handleMessage
  sendJson(child, {
    jsonrpc: "2.0", id: 0, method: "initialize",
    params: {
      protocolVersion: "2024-11-05",
      capabilities: {},
      clientInfo: { name: "llm-ext-cli", version: "1.0.0" },
    },
  });

  // Global deadline
  const deadline = setTimeout(() => {
    console.error("ERROR: Timeout after 10 minutes");
    killAndExit(child, 1);
  }, 600_000);

  // Forward server stderr to our stderr so crashes and diagnostic logs are visible
  child.stderr.on("data", (chunk) => {
    process.stderr.write(chunk);
  });
}

main().catch((err) => {
  console.error(`ERROR: ${err.message}`);
  process.exit(1);
});
