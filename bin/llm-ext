#!/usr/bin/env node
/**
 * llm-ext — the LLM Externalizer CLI.
 *
 *   llm-ext --help                    list every command
 *   llm-ext <command> --help          show one command's parameters
 *   llm-ext <command> [--flag value]  run it
 *
 * Examples:
 *   llm-ext chat --instructions "Summarize" --input_files_paths /path/to/file.ts
 *   llm-ext code-task --instructions "Find bugs" --folder_path /path/to/src
 *   llm-ext discover
 *
 * Output: the report path (or the tool's text) on STDOUT; banner, progress and
 * diagnostics on STDERR. Exit 0 on success, 1 on failure.
 *
 * This file used to be ~740 lines: it spawned the MCP server as a child
 * process, spoke JSON-RPC to it over stdio, and carried its own hand-maintained
 * copy of the tool catalog just to render `--help`. All of that is gone. The
 * command table, help text and flag types are now generated from the one real
 * tool catalog, and tools run in THIS process — no subprocess, no protocol, and
 * no second copy of the docs to drift out of sync.
 *
 * We go through launcher.mjs rather than importing dist/llm-ext.js directly
 * because the launcher self-installs the native `better-sqlite3` binding that
 * mass-scout's SQLite registry needs — the plugin ships with node_modules
 * gitignored, so on a fresh clone it is genuinely absent.
 */

const { join } = require("path");
const { existsSync } = require("fs");
const { pathToFileURL } = require("url");

const launcher = join(__dirname, "..", "mcp-server", "launcher.mjs");

if (!existsSync(launcher)) {
  console.error(`llm-ext: launcher not found at ${launcher}`);
  console.error(
    "Run 'python3 scripts/setup.py' in the plugin directory to build it.",
  );
  process.exit(1);
}

import(pathToFileURL(launcher).href).catch((err) => {
  console.error(`llm-ext: ${err && err.message ? err.message : err}`);
  process.exit(1);
});
