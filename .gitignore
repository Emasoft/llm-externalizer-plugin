# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
# uv.lock: scripts/ are stdlib-only (no runtime deps in pyproject.toml),
# so a lockfile adds no value. If deps are ever introduced, remove this
# comment and commit uv.lock alongside them.

# Node
node_modules/
scripts/llm-ext/node_modules/
scripts/llm-ext/*.tsbuildinfo
scripts/llm-ext/*.tgz
scripts/llm-ext/coverage/
scripts/llm-ext/logs/
scripts/llm-ext/llm_externalizer_output/
scripts/llm-ext/reports_dev/
reports_dev/
# Audit output from /llm-externalizer:* commands (and any plugin agent).
# Reports routinely contain absolute local paths, raw LLM responses, and
# redacted secret markers — never publish them. Agents should write to the
# root-project ./reports/ even when running inside a git worktree.
reports/
scripts/llm-ext/reports/

# Build artifacts
dist/
!scripts/llm-ext/dist/
# …but never the source maps: debug-only, not needed at runtime, and they trip
# CPV's RC-70 security heuristic (esbuild config sets sourcemap:false anyway).
scripts/llm-ext/dist/*.map
build/

# macOS
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/
CLAUDE.md
.tldr/
.tldrignore

# Dev folders (not published)
*_dev/

# Logs
*.log
logs/

# Environment
.env
.env.*

# Security / validation output
security-results/
validation-report.txt

# LLM Externalizer output
llm_externalizer_output/
*.externbak
*.externtmp
*.bak
# TLDR artifacts (added by rechecker)
.tldr_session_*
.publish.lock
/reports/
/reports_dev/
# Dev-only working folders: scratch, drafts, abandoned-work patches. Never
# published, never part of the source distribution — and they routinely hold
# absolute local paths and private data, so committing one is a leak.
/docs_dev/
/scripts_dev/
/samples_dev/
/examples_dev/
/tests_dev/
/downloads_dev/
/libs_dev/
/builds_dev/
/.trashcan/*
!/.trashcan/.gitkeep
!/.trashcan/README.txt
