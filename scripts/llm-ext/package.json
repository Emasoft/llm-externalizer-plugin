{
  "name": "llm-externalizer",
  "version": "13.3.1",
  "type": "module",
  "description": "CLI that offloads bounded LLM tasks to cheaper local (LM Studio, Ollama, vLLM, llama.cpp) or remote (OpenRouter) models. Free models by default; profile-based configuration with ensemble mode.",
  "main": "dist/index.js",
  "bin": {
    "llm-ext": "dist/llm-ext.js",
    "llm-externalizer": "dist/llm-ext.js"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run --exclude 'src/live*.test.ts'",
    "test:live": "vitest run src/live.test.ts src/live-extended.test.ts src/live-websearch.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "lm-studio",
    "ollama",
    "vllm",
    "openai",
    "openai-compatible",
    "openrouter",
    "local-llm",
    "ai-tools",
    "llama-cpp",
    "ai",
    "llm",
    "model-switching",
    "llm-externalizer"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "gpt-tokenizer": "^3.4.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "server.json",
    "LICENSE"
  ]
}
